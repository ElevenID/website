FROM nginx:1.29.1-alpine@sha256:42a516af16b852e33b7682d5ef8acbd5d13fe08fecadc7ed98605ba5e3b26ab8

ARG WEBSITE_SOURCE_SHA
ARG WEBSITE_REVISION
ARG WEBSITE_ROUTE_CONTRACT_SHA256

LABEL org.opencontainers.image.source="https://github.com/ElevenID/website" \
      org.opencontainers.image.revision="${WEBSITE_SOURCE_SHA}" \
      org.opencontainers.image.version="${WEBSITE_REVISION}" \
      com.elevenid.website.repository="ElevenID/website" \
      com.elevenid.website.audience="production" \
      com.elevenid.website.pages="public" \
      com.elevenid.website.route-contract-sha256="${WEBSITE_ROUTE_CONTRACT_SHA256}"

RUN rm -f /etc/nginx/conf.d/default.conf

COPY nginx.website.conf /etc/nginx/conf.d/default.conf
COPY nginx.website.routes.conf /etc/nginx/marty-website-routes.conf
COPY nginx.website.headers.conf /etc/nginx/marty-website-headers.conf
COPY html/ /usr/share/nginx/html/

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
