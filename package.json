{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "description": "ElevenID website extraction and contract checks",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "npm run test:contracts && npm run test:dom && npm run test:build",
    "test:contracts": "node --experimental-vm-modules --test tests/*.test.mjs tests/vm/*.test.mjs ui/scripts/dev-server-origin.test.mjs ui/scripts/generated-text.test.mjs",
    "test:dom": "vitest run --config vitest.dom.config.mjs",
    "test:build": "node --test --test-concurrency=1 tests/build/*.test.mjs",
    "test:nginx": "node --test --test-concurrency=1 tests/nginx/*.test.mjs",
    "prebuild:website": "node ui/scripts/generate-demo-manifest-module.mjs",
    "build:website": "node ui/scripts/build-web-surface.mjs website",
    "build:website:production": "npm run build:website && node scripts/prerender-website.mjs && node scripts/verify-prerendered-website.mjs"
  },
  "dependencies": {
    "@elevenid/marty-blog": "https://github.com/ElevenID/marty-blog/releases/download/v0.1.9/elevenid-marty-blog-0.1.9.tgz",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/icons-material": "9.3.0",
    "@mui/material": "9.4.0",
    "i18next": "26.5.7",
    "i18next-browser-languagedetector": "8.2.1",
    "i18next-http-backend": "4.0.4",
    "prop-types": "15.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-i18next": "17.0.12",
    "react-router": "8.3.0",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  }
}
