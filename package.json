{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "description": "ElevenID website extraction and contract checks",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "test": "npm run test:contracts && npm run test:dom",
    "test:contracts": "node --experimental-vm-modules --test tests/*.test.mjs tests/vm/*.test.mjs ui/scripts/dev-server-origin.test.mjs ui/scripts/generated-text.test.mjs",
    "test:dom": "vitest run --config vitest.dom.config.mjs"
  },
  "dependencies": {
    "prop-types": "15.8.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "vite": "8.3.6",
    "vitest": "5.0.5"
  }
}
